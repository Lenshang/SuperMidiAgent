{
  "name": "super-midi-agent",
  "productName": "SuperMidiAgent",
  "version": "0.1.1",
  "private": true,
  "description": "SuperMidiAgent — 基于 Electron + Ant Design X + MCP 的 AI MIDI 生成与编辑工具",
  "author": "SuperMidiAgent <supermidiagent@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lenshang/SuperMidiAgent.git"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "node build.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:renderer": "vite",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "cross-env RUN_LIVE=1 vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/x": "^2.9.0",
    "@types/node": "^22.15.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "antd": "^6.6.5",
    "cross-env": "^10.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.8"
  },
  "build": {
    "appId": "com.supermidi.agent",
    "productName": "SuperMidiAgent",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "normal",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "identity": null,
      "artifactName": "SuperMidiAgent-${version}-${arch}-mac.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Audio",
      "maintainer": "SuperMidiAgent <supermidiagent@users.noreply.github.com>",
      "mimeTypes": [
        "audio/midi",
        "audio/x-midi"
      ],
      "artifactName": "SuperMidiAgent-${version}-${arch}-linux.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SuperMidiAgent"
    },
    "portable": {
      "artifactName": "SuperMidiAgent-Portable-${version}.exe"
    }
  }
}
